<ItemsControl ItemsSource="{Binding TranscriptLines}" 
              VirtualizingPanel.IsVirtualizing="True" 
              VirtualizingPanel.VirtualizationMode="Recycling"
              ScrollViewer.CanContentScroll="True">
    
    <!-- Explicit VirtualizingStackPanel ItemsPanelTemplate -->
    <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    
    <!-- Template for Transcript Lines -->
    <ItemsControl.ItemTemplate>
        <DataTemplate>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Times Column -->
                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="Gray" Margin="0,0,10,0"/>
                
                <!-- Transcription Text with per-word confidence -->
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </ItemsControl.ItemTemplate>
    
    <ItemsControl.Template>
        <ControlTemplate>
            <ScrollViewer x:Name="TranscriptScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
    </ItemsControl.Template>
</ItemsControl>