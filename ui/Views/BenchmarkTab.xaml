<!--
    The benchmark runner. DataContext is BenchmarkVm. The measurement itself
    runs behind the bridge on the LIVE backend with the worker paused; rows
    arrive as benchmark events, which is why nothing here waits on anything.
-->
<UserControl x:Class="LiveTranscription.Ui.Views.BenchmarkTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:LiveTranscription.Ui.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,10,14,10" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource PanelText2Brush}"
                       Text="Times this machine through the backend that is actually serving your captions. Whisper pads every window to 30 s internally, so a longer buffer costs about what a short one costs - the table below is where that intuition goes to die. Transcription is paused while it runs; capture is not." />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="330" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox MinWidth="130"
                            PlaceholderText="4, 8, 16, 24"
                            ToolTip="Buffer sizes to measure, in seconds"
                            Text="{Binding Buffers}" />
                <ui:NumberBox Grid.Column="1" Margin="8,0,0,0" MinWidth="90"
                              Minimum="1" Maximum="10" SmallChange="1"
                              ToolTip="Repetitions per size - the median is what counts"
                              Value="{Binding Reps}" />
                <Grid Grid.Column="2" Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="(synthetic tones - give it a WAV of real speech)"
                                ToolTip="A 16-bit PCM WAV of real speech. Synthetic tones decode almost no tokens, so they measure the encoder floor and nothing else."
                                Text="{Binding WavPath}" />
                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Browse"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Click="OnBrowseWav" />
                </Grid>
                <ui:Button Grid.Column="3" Margin="12,0,0,0"
                           Content="Run benchmark"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Timer24}"
                           Command="{Binding RunCommand}" />
                <ui:ProgressRing Grid.Column="4" Margin="10,0,0,0"
                                 Width="22" Height="22"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <TextBlock Margin="0,0,0,8" FontSize="12"
                       Foreground="{DynamicResource PanelText2Brush}"
                       Text="{Binding Status}" />

            <ui:ListView ItemsSource="{Binding Rows}"
                         SelectionMode="Single"
                         MaxHeight="320">
                <ListView.View>
                    <!-- WPF-UI's GridView, not the stock one: the stock
                         GridViewColumnHeader template is classic-white and
                         no theme dictionary touches it, so the header rendered
                         as a white band with a black hairline in BOTH themes
                         (first real render, 2026-08-23). -->
                    <ui:GridView>
                        <ui:GridViewColumn Header="buffer" Width="70"
                                        DisplayMemberBinding="{Binding BufferText}" />
                        <ui:GridViewColumn Header="median" Width="80"
                                        DisplayMemberBinding="{Binding MedianText}" />
                        <ui:GridViewColumn Header="spread" Width="110"
                                        DisplayMemberBinding="{Binding SpreadText}" />
                        <ui:GridViewColumn Header="chars" Width="70"
                                        DisplayMemberBinding="{Binding Chars}" />
                        <ui:GridViewColumn Header="xRT" Width="90">
                            <ui:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding XrtText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource PanelDangerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Sustainable}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource PanelOkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ui:GridViewColumn.CellTemplate>
                        </ui:GridViewColumn>
                        <ui:GridViewColumn Header="slide it sustains" Width="120"
                                        DisplayMemberBinding="{Binding SlideText}" />
                    </ui:GridView>
                </ListView.View>
            </ui:ListView>

            <!--
                Synthetic numbers are a lower bound, not a prediction - said
                on screen because acting on them is the natural mistake.
            -->
            <ui:InfoBar Margin="0,8,0,0"
                        IsClosable="False"
                        Severity="Warning"
                        Title="Measured on synthetic tones"
                        Message="Tones decode to almost no text, so this measures the encoder and little else. Point it at a WAV of real speech for numbers you can act on."
                        IsOpen="{Binding Synthetic, Mode=OneWay}" />

            <Border Margin="0,8,0,0" Padding="14,10" CornerRadius="12"
                    Background="{DynamicResource PanelCardBrush}"
                    BorderBrush="{DynamicResource PanelLineBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="500"
                               Text="{Binding Recommendation}" />
                    <ui:Button Margin="14,0,0,0" VerticalAlignment="Center"
                               Content="Apply to the running session"
                               Appearance="Primary"
                               ToolTip="Sets strategy, buffer and slide together - the validator rejects them one at a time"
                               Command="{Binding ApplyRecommendationCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
