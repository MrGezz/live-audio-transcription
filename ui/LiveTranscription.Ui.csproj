<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop panel's View layer. This assembly knows nothing about Python:
    it talks to IEngineBridge, which Python implements (wpf_panel.py). That is
    what keeps the XAML bindable - pythonnet projects a Python class as a CLR
    type with ZERO properties, so {Binding} against a Python object silently
    renders an empty string. ViewModels therefore have to be C#.

    Library, not WinExe: the process is python.exe. PanelHost.Start() is the
    entry point, called over pythonnet from a .NET-created STA thread.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LiveTranscription.Ui</AssemblyName>
    <RootNamespace>LiveTranscription.Ui</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      net8.0-windows, not net10: 8.0 is the lowest Desktop runtime that ships
      WPF-UI 4.3.0's target, so a cloner needs only Microsoft.WindowsDesktop.App
      8.0 - or, with the RollForward below, any newer one. Building against 10
      would REQUIRE 10.
    -->

    <!--
      Major, not LatestMinor. LatestMinor never leaves the requested major:
      a machine with only the .NET 9 or 10 Desktop Runtime installed - which is
      what dotnet.microsoft.com hands out today - failed to host the panel with
      "runtime 8.0 or newer was not found", and the "or newer" was a lie.
      Major runs on 8.x when it is there and otherwise takes the next major
      that is, which is the promise the README makes. LatestMajor would skip
      an installed 8.x for a newer one; there is no reason to prefer that.
      See the roll-forward table at learn.microsoft.com/dotnet/core/versions/selection.
    -->
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>

    <!--
      No .pdb in Release: the publish output is committed (ui/runtime), and
      a symbols file that regenerates on every build is a permanent source
      of meaningless diffs there. Debug builds keep theirs.
    -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>

    <!--
      A Library does NOT get a runtimeconfig.json by default - only executables
      do - but pythonnet needs one to host the CLR, and it must name
      Microsoft.WindowsDesktop.App. clr_loader's auto-generated config filters
      to Microsoft.NETCore.App, which contains no WPF, so hosting without this
      file fails with FileNotFoundException on PresentationFramework.
      Generating it here rather than hand-writing one keeps the framework
      version tied to TargetFramework instead of drifting from it.
    -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!--
      From nuget.org by package id, never a ProjectReference to a checkout.
      Two reasons: every path in this project stays relative to the repo root
      so the folder can be moved or cloned, and a local wpfui clone is liable
      to sit some commits past its tag - silent version drift.
    -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
