<UserControl x:Class="LiveTranscription.Ui.Views.BenchmarkTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Control Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <ui:Button Command="{Binding RunBenchmarkCommand}" 
                       Icon="Timer24" 
                       Appearance="Primary" 
                       Content="Run Benchmark" 
                       Margin="0,0,16,0"/>
            
            <ui:ProgressRing IsIndeterminate="True" 
                             Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" 
                             Margin="0,0,16,0" Width="20" Height="20"/>
            
            <TextBlock Text="{Binding BenchmarkStatus}" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <!-- Benchmark Results Console/List -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="4" Padding="8">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" Foreground="#D4D4D4" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>