<!--
    HAND-WRITTEN, unlike Charcoal.xaml next to it. These are the panel's own
    semantic keys - confidence bands, pill tones, meter tracks - which no
    WPF-UI dictionary defines, so there is nothing to generate them from.
    gen_theme.py regenerates its files around this one and never touches it.

    Values come from webui/style.css's dark palette (ok / warn / danger /
    violet / accent and the greys), so a word that reads as doubtful in the
    browser panel reads as doubtful here. Edit style.css first, then mirror.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- word confidence: low is under confidence_warn, mid up to the midpoint
         between that and 1, hi the rest. Same bands as webui/app.js:788. -->
    <SolidColorBrush x:Key="ConfidenceLowBrush" Color="#FFFF5252" />
    <SolidColorBrush x:Key="ConfidenceMidBrush" Color="#FFFFB300" />
    <SolidColorBrush x:Key="ConfidenceHighBrush" Color="#FFECF4F7" />

    <!-- pill / state tones -->
    <SolidColorBrush x:Key="PanelOkBrush" Color="#FF4CAF50" />
    <SolidColorBrush x:Key="PanelWarnBrush" Color="#FFFFB300" />
    <SolidColorBrush x:Key="PanelDangerBrush" Color="#FFFF5252" />
    <SolidColorBrush x:Key="PanelVioletBrush" Color="#FF7C4DFF" />
    <SolidColorBrush x:Key="PanelAccentBrush" Color="#FF00BCD4" />
    <!-- the web palette's accent-2, the hover step. PanelHost.ApplyAccent
         feeds this pair to WPF-UI's accent manager verbatim, so every
         accent-derived brush (primary buttons, ON toggles, slider thumbs,
         focus borders) is the web panel's cyan, not a brightened one. -->
    <SolidColorBrush x:Key="PanelAccent2Brush" Color="#FF4DD0E1" />
    <SolidColorBrush x:Key="PanelAccentSoftBrush" Color="#1F00BCD4" />
    <!-- ink on the danger fill. NOT theme-invariant: the light danger is
         darker than this one, so the winning ink flips to white there. -->
    <SolidColorBrush x:Key="PanelDangerInkBrush" Color="#FF0B1013" />

    <!-- text tiers and chrome -->
    <SolidColorBrush x:Key="PanelText2Brush" Color="#FF8FA6B2" />
    <SolidColorBrush x:Key="PanelMutedBrush" Color="#FF5F7885" />
    <SolidColorBrush x:Key="PanelLineBrush" Color="#FF283B45" />
    <SolidColorBrush x:Key="PanelCardBrush" Color="#FF141E24" />
    <SolidColorBrush x:Key="PanelTrackBrush" Color="#FF0D1417" />

    <!-- WPF-UI's default is 4; the web panel's inputs and buttons use the
         CSS radius-sm token, 8px. Every control style reaches this key
         through DynamicResource, so one override here is the whole change.
         Cards are the radius token, 12, set where each card is declared. -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

    <!-- .pill chrome: the panel colour at 60 % for the fill, and a border
         that takes the tone's hue at 45 % (danger 50 %) instead of the line
         colour. A transcript
         line's tag shares the hue brushes for its edge where the CSS says
         35 % - one key per hue, ten points of alpha, on purpose. -->
    <SolidColorBrush x:Key="PanelPillFillBrush" Color="#99152026" />
    <SolidColorBrush x:Key="PanelOkLineBrush" Color="#734CAF50" />
    <SolidColorBrush x:Key="PanelWarnLineBrush" Color="#73FFB300" />
    <SolidColorBrush x:Key="PanelDangerLineBrush" Color="#80FF5252" />
    <SolidColorBrush x:Key="PanelVioletLineBrush" Color="#737C4DFF" />
    <!-- the accent at 20 %: the edge of an accent-soft chip (.eyebrow) -->
    <SolidColorBrush x:Key="PanelAccentLineBrush" Color="#3300BCD4" />
    <!-- the hue at 14 %: a transcript tag's tint (.tag.server, .tag.local) -->
    <SolidColorBrush x:Key="PanelVioletSoftBrush" Color="#247C4DFF" />
    <SolidColorBrush x:Key="PanelWarnSoftBrush" Color="#24FFB300" />

    <!-- meter fills, .bar i and .bar i.vad: the gradient runs across the
         fill's own width, as the CSS paints it, not across the track -->
    <LinearGradientBrush x:Key="PanelLevelFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF4CAF50" />
        <GradientStop Offset="1" Color="#FFFFB300" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelVadFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF00BCD4" />
        <GradientStop Offset="1" Color="#FF7C4DFF" />
    </LinearGradientBrush>
</ResourceDictionary>
