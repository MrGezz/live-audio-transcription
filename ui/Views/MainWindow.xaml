<ui:FluentWindow
    x:Class="LiveTranscription.Ui.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:LiveTranscription.Ui.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Live Transcription"
    Width="1180" Height="760" MinWidth="820" MinHeight="520"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <!--
        Background is set explicitly even though WindowBackdropType is Mica.
        Mica is a DWM system backdrop; where DWM composition is off - Windows
        10, RDP, some VMs - an unset Background renders WHITE, which on a
        charcoal palette is not a degraded look but an unreadable one.
    -->

    <ui:FluentWindow.Resources>
        <conv:SeverityConverter x:Key="Severity" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Live Transcription" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Mic24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- top actions -->
        <Border Grid.Row="1" Padding="18,6,18,10">
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="BtnRun"
                           Command="{Binding StartCommand}"
                           Content="{Binding RunButtonText}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Play24}" />
                <ui:Button Margin="8,0,0,0"
                           Command="{Binding RestartCommand}"
                           Content="Restart"
                           Icon="{ui:SymbolIcon ArrowSync24}" />
                <ui:Button Margin="8,0,0,0"
                           Command="{Binding PauseCommand}"
                           Content="{Binding PauseButtonText}"
                           Icon="{ui:SymbolIcon Pause24}" />

                <ui:TextBlock VerticalAlignment="Center" Margin="16,0,0,0"
                              Appearance="Secondary"
                              Text="{Binding Status}" />
            </StackPanel>
        </Border>

        <!--
            The banner sits above everything, because that is where the eye
            already is when nothing is happening: "the meters are flat" and
            "nothing is running" look identical until something says which.
        -->
        <ui:InfoBar Grid.Row="2" Margin="18,0,18,10"
                    IsOpen="{Binding BannerOpen}"
                    Severity="{Binding BannerSeverity, Converter={StaticResource Severity}}"
                    Title="{Binding BannerTitle}"
                    Message="{Binding BannerMessage}" />

        <ui:TextBlock Grid.Row="3" Margin="18"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Appearance="Secondary"
                      Text="panel shell - tabs land here" />
    </Grid>
</ui:FluentWindow>
